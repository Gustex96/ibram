<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Desabilita tráfego HTTP em texto claro para proteger a integridade dos dados e evitar alertas de segurança do Play Protect -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
